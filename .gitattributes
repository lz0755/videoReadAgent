# Enforce LF line endings for byte-hashed prompt templates and contract/CI files
# so Windows checkouts with core.autocrlf=true produce identical SHA-256 digests to CI.
prompts/** text eol=lf
*.jinja2 text eol=lf
prompts/registry.json text eol=lf
Dockerfile.ci text eol=lf
.github/** text eol=lf
*.sql text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# D1 receipts bind exact on-disk bytes on both Windows and Linux.
eval/d1.py text eol=lf
eval/d1_metrics.py text eol=lf
eval/manifests/dev_seed.jsonl text eol=lf
eval/annotations/dev_seed/dev_seed_questions.json text eol=lf
eval/manifests/d1_*.json text eol=lf
